# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jmt_travels?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/jmt_travels
MONGODB_URI=

# Authentication Secret Key (Required in Production)
AUTH_SECRET=local-development-jmt-jwt-secret-key-2026

# Payment Gateway Configuration (mock, paytabs, or thawani)
# Use 'mock' for local sandbox & testing without credentials.
PAYMENT_PROVIDER=mock

# PayTabs GCC Payment Gateway Credentials (PREPARED ONLY)
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_CLIENT_KEY=
PAYTABS_REGION=OMN

# Thawani Oman Payment Gateway Credentials (PREPARED ONLY)
THAWANI_PUBLIC_KEY=
THAWANI_SECRET_KEY=

# Webhook Authentication Secret
PAYMENT_WEBHOOK_SECRET=sandbox-secret-key-jmt

# Notification Provider Configuration (mock, resend, or ses)
# Use 'mock' for local sandbox & testing without live API keys.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
AWS_REGION=
AWS_SES_FROM_EMAIL=

# SMS & WhatsApp Provider Credentials (PREPARED ONLY)
SMS_PROVIDER=mock
SMS_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATION_FROM_EMAIL="JMT TRAVELS" <noreply@jmttravels.com>

# AI Assistant Gateway Configuration (mock or production LLM gateway e.g. gemini/openai)
# Use 'mock' (default) for local sandbox & automated testing without live credentials.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Nodemailer / SMTP Configuration (Optional - fallback to local sandbox logger if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email Targets
FEEDBACK_EMAIL=info@jmttravels.com
FROM_EMAIL="JMT TRAVELS" <noreply@jmttravels.com>

# Staff Console Credentials
ADMIN_EMAIL=admin@jmttravels.com
ADMIN_PASSWORD=JMTAdmin2026!
ADMIN_ACCESS_KEY=JMTAdmin2026!
